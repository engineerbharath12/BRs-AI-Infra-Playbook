diagram "Without Pathways (McJAX) vs With Pathways Single-Controller Elasticity" {
  description: "Architectural comparison of why a single host hardware failure kills 100% of a traditional McJAX job vs in-process recovery in Google Cloud Pathways"
  theme: gcp-architecture
  renderOrder: nodes-first

  macro ProductCard(name, label, sublabel, icon, fill, stroke, textColor) {
    node $name "$label" {
      sublabel: "$sublabel"
      shape: rectangle
      width: 174
      height: 58
      icon: "$icon"
      iconPosition: left-badge
      fill: "$fill"
      stroke: "$stroke"
      strokeWidth: 1.5
      textColor: "$textColor"
      fontSize: 11
      cornerRadius: 8
      shadow: true
    }
  }

  macro GatewayHubCard(name, label, sublabel, icon, fill, stroke, textColor) {
    node $name "$label" {
      sublabel: "$sublabel"
      shape: rectangle
      width: 204
      height: 68
      icon: "$icon"
      iconPosition: left-badge
      fill: "$fill"
      stroke: "$stroke"
      strokeWidth: 2
      textColor: "$textColor"
      fontSize: 12
      cornerRadius: 8
      shadow: true
    }
  }

  layout {
    type: grid
    direction: LR
    columns: 4
    rows: 2
    columnGap: 68
    rowGap: 28
  }

  group fault_event "1. Cluster Interruption Trigger" {
    style: container
    fill: "#f8fafc"
    stroke: "#cbd5e1"
    textColor: "#1e293b"
    gridColumn: 1
    gridRow: 1
    gridRowSpan: 2
    padding: 16
    layout {
      type: stack
      direction: TB
      gap: 18
    }

    @GatewayHubCard(evt_trigger, "Single TPU Host Hardware Failure", "1 Host Fault Across Multi-Slice Cluster", "Server", "#fee2e2", "#ef4444", "#7f1d1d")
    @ProductCard(evt_cause1, "Software & Node Upgrades", "Scheduled OS / Driver Maintenance", "GKE", "#f1f5f9", "#64748b", "#334155")
    @ProductCard(evt_cause2, "DWS Flex / Spot Preemption", "Higher-Priority Workload Eviction", "Activity", "#f1f5f9", "#64748b", "#334155")

    evt_cause1 -> evt_trigger {
      stroke: "#64748b"
      strokeWidth: 1.5
    }
    evt_cause2 -> evt_trigger {
      stroke: "#64748b"
      strokeWidth: 1.5
    }
  }

  group mcjax_plane "Without Pathways: Coupled Multi-Controller (McJAX)" {
    style: container
    fill: "#fef2f2"
    stroke: "#fca5a5"
    textColor: "#7f1d1d"
    gridColumn: 2
    gridRow: 1
    gridColumnSpan: 2
    padding: 16
    layout {
      type: grid
      direction: LR
      columns: 2
      rows: 2
      columnGap: 36
      rowGap: 14
    }

    @ProductCard(mc_workers, "Coupled Python Pods", "Every TPU Host Runs JAX + PyGrain", "Cpu", "#fee2e2", "#ef4444", "#7f1d1d")
    @ProductCard(mc_abort, "Global Collective Abort", "All Healthy Hosts Crash on Timeout", "Networking", "#fecaca", "#dc2626", "#7f1d1d")
    @ProductCard(mc_teardown, "JobSet Tears Down All Pods", "Container Recreate + Python Cold Init", "GKE", "#fecaca", "#dc2626", "#7f1d1d")
    @ProductCard(mc_recompile, "Full XLA Recompile + GCS Load", "All Replicas Read GCS Simultaneously", "GcpStorageBucket", "#fee2e2", "#ef4444", "#7f1d1d")

    mc_workers -> mc_abort {
      stroke: "#dc2626"
      strokeWidth: 2
    }
    mc_abort -> mc_teardown {
      stroke: "#dc2626"
      strokeWidth: 2
    }
    mc_teardown -> mc_recompile {
      stroke: "#dc2626"
      strokeWidth: 2
    }
  }

  group pathways_plane "With Pathways: Decoupled Single-Controller" {
    style: container
    fill: "#f0fdf4"
    stroke: "#86efac"
    textColor: "#14532d"
    gridColumn: 2
    gridRow: 2
    gridColumnSpan: 2
    padding: 16
    layout {
      type: grid
      direction: LR
      columns: 2
      rows: 2
      columnGap: 36
      rowGap: 14
    }

    @ProductCard(pw_head, "Decoupled JAX Coordinator", "Runs on CPU · Survives TPU Faults", "VertexAI", "#dcfce7", "#22c55e", "#14532d")
    @ProductCard(pw_catch, "IFRT Catches Slice Disconnect", "Python Process Stays Alive (restartCount=0)", "ShieldCheck", "#dcfce7", "#22c55e", "#14532d")
    @ProductCard(pw_remap, "Resource Manager Remaps Mesh", "Option 1 Resize or Option 2 Pause & Resume", "GcpShuffle", "#bbf7d0", "#16a34a", "#14532d")
    @ProductCard(pw_resume, "Warm XLA Cache + DCN Sync", "Zero Cold Pod Boot · Seamless Scale-Up", "Layers", "#bbf7d0", "#16a34a", "#14532d")

    pw_head -> pw_catch {
      stroke: "#16a34a"
      strokeWidth: 2
    }
    pw_catch -> pw_remap {
      stroke: "#16a34a"
      strokeWidth: 2
    }
    pw_remap -> pw_resume {
      stroke: "#16a34a"
      strokeWidth: 2
    }
  }

  group impact_out "Production SLA & Goodput Impact" {
    style: container
    fill: "#eff6ff"
    stroke: "#93c5fd"
    textColor: "#1e3a8a"
    gridColumn: 4
    gridRow: 1
    gridRowSpan: 2
    padding: 16
    layout {
      type: stack
      direction: TB
      gap: 24
    }

    @GatewayHubCard(mc_kpi, "McJAX: 100% Cluster Idle", "Baseline Downtime · High GCS Egress Spike", "CloudMonitoring", "#fee2e2", "#dc2626", "#7f1d1d")
    @GatewayHubCard(pw_kpi, "Pathways: 53% Faster Recovery", "Zero Head Restarts · +42% Effective Goodput", "GoogleCloud", "#dcfce7", "#16a34a", "#14532d")

    mc_kpi -> pw_kpi {
      label: "Upgrade to Pathways"
      stroke: "#2563eb"
      strokeWidth: 2
      style: dashed
    }
  }

  evt_trigger -> mc_workers {
    label: "Kills All Pods"
    stroke: "#dc2626"
    strokeWidth: 2
  }
  evt_trigger -> pw_head {
    label: "Isolated to 1 Slice"
    stroke: "#16a34a"
    strokeWidth: 2
  }
  mc_recompile -> mc_kpi {
    stroke: "#dc2626"
    strokeWidth: 2
  }
  pw_resume -> pw_kpi {
    stroke: "#16a34a"
    strokeWidth: 2
  }
}
